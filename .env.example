# ============================================================
# Job Market Intelligence Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control!
#
# How to get each key:
# ============================================================

# ------------------------------------------------------------
# LLM Provider — Groq (FREE)
# Sign up: https://console.groq.com
# Recommended model: llama-3.3-70b-versatile
# ------------------------------------------------------------
GROQ_API_KEY=YOUR-GROQ-API-KEY-HERE
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# ------------------------------------------------------------
# GitHub API (FREE — no scopes needed)
# Sign up: https://github.com/settings/tokens
# Click "Generate new token (classic)" — no boxes needed
# ------------------------------------------------------------
GITHUB_TOKEN=YOUR-GITHUB-TOKEN-HERE

# ------------------------------------------------------------
# Tavily Search API (FREE tier: 1000 calls/month)
# Sign up: https://app.tavily.com
# ------------------------------------------------------------
TAVILY_API_KEY=YOUR-TAVILY-KEY-HERE

# ------------------------------------------------------------
# Adzuna Jobs API (FREE developer account)
# Sign up: https://developer.adzuna.com/overview
# You'll get both an App ID and App Key
# ------------------------------------------------------------
ADZUNA_APP_ID=YOUR-ADZUNA-APP-ID
ADZUNA_APP_KEY=YOUR-ADZUNA-APP-KEY

# ------------------------------------------------------------
# Reddit API (OPTIONAL — for community sentiment analysis)
# Sign up: https://www.reddit.com/prefs/apps
# Click "create another app" → select "script"
# ------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=JobMarketIntelligenceBot/1.0

# ------------------------------------------------------------
# PostgreSQL Database (runs in Docker)
# These values must match your docker-compose.yml
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_market_db
POSTGRES_USER=job_market_user
POSTGRES_PASSWORD=ENTERPASSWORD
# NOTE: the variable name config.py actually reads is SQLALCHEMY_DATABASE_URL
# (not DATABASE_URL) — using the wrong name here means your custom
# credentials above are silently ignored and the config.py default is used.
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://job_market_user:ENTERPASSWORD@localhost:5432/job_market_db
   
# ------------------------------------------------------------
# pgAdmin (optional web UI for PostgreSQL)
# ------------------------------------------------------------
PGADMIN_EMAIL=admin@jobmarket.dev
PGADMIN_PASSWORD=admin

# ------------------------------------------------------------
# FastAPI Settings
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ------------------------------------------------------------
# Chainlit UI Settings
# ------------------------------------------------------------
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8001

# ------------------------------------------------------------
# Agent Settings
# ------------------------------------------------------------
# Maximum number of job postings to analyze per query
MAX_JOB_POSTINGS=100
# Maximum retries on API failures
MAX_RETRIES=3
# Timeout in seconds for external API calls
API_TIMEOUT=30

# ------------------------------------------------------------
# Resume Upload Settings
# ------------------------------------------------------------
# Directory to save uploaded resumes
RESUME_UPLOAD_DIR=./uploads/resumes
# Maximum file size in MB
MAX_RESUME_SIZE_MB=10
